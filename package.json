		"@tauri-apps/plugin-window-state": "~2.4.1",
		"pnpm": "^11.14.0",
		"sharp": "^0.35.3",
		"svgo": "^4.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.1.1",
		"eslint": "^9.39.5",
